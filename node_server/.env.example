PORT=5001
BACKEND_BASE_URL=http://localhost:5001
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Database provider: mysql or postgres.
# Postgres/Supabase migration will use postgres.
DB_PROVIDER=postgres

# Supabase Postgres connection.
# Recommended for hosted/serverless backends: use the Transaction pooler URL from Supabase.
# Format:
# postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=
DB_SSL=true

# Legacy MySQL values. Keep only while migrating from MySQL.
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

JWT_SECRET=
JWT_EXPIRE=7d

# Google Drive OAuth. Do not commit real client secrets or refresh tokens.
# This must exactly match an authorized redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:5001/oauth2callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
